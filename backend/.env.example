PORT=3000

NODE_ENV=development

# Local / development database (e.g. the external postgres container on localhost:5432).
DATABASE_URL="postgresql://admin:password@localhost:5432/Forge"

# Production database (AWS RDS). Only read when NODE_ENV=production.
# If unset in production, the app falls back to DATABASE_URL and logs a deprecation warning.
DATABASE_URL_PROD="postgresql://user:password@your-rds-host:5432/Forge"

# CA bundle for the production TLS connection. Defaults to /app/certs/global-bundle.pem.
# Only read when NODE_ENV=production.
DB_SSL_CA_PATH=/app/certs/global-bundle.pem

LOG_LEVEL=info

JWT_SECRET=replace_me_at_least_32_chars_long_placeholder
JWT_EXPIRES_IN=60m

REFRESH_TOKEN_SECRET=replace_me_at_least_32_chars_long_placeholder_xx
REFRESH_TOKEN_EXPIRES_IN=7d

COOKIE_SECRET=replace_me_at_least_32_chars_long_placeholder_xxx

CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=000000000000000
CLOUDINARY_API_SECRET=your_cloudinary_api_secret

GOOGLE_CLIENT_ID=your_google_client_id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your_google_client_secret
GOOGLE_REDIRECT_URI=http://localhost:3000/api/v1/auth/google/callback

GITHUB_CLIENT_ID=your_github_client_id
GITHUB_CLIENT_SECRET=your_github_client_secret
GITHUB_REDIRECT_URI=http://localhost:3000/api/v1/auth/github/callback

CLIENT_URL=http://localhost:5173

REDIS_URL=redis://localhost:6379
REALTIME_RELAY_ENABLED=false

VITE_API_BASE_URL=http://localhost:3000/api/v1

# ---- Object storage (S3 primary, Cloudinary fallback) ----
# S3 is the default primary. If these are unset/config invalid, the storage
# strategy transparently falls back to Cloudinary, so boot never fails.
AWS_REGION=us-east-1
AWS_ACCESS_KEY=your_aws_access_key
AWS_SECRET_ACCESS_KEY=your_aws_secret_access_key
AWS_S3_BUCKET=your-s3-bucket-name
# Optional: S3-compatible endpoint (e.g. MinIO for local dev)
AWS_ENDPOINT=
AWS_FORCE_PATH_STYLE=false

# Primary object store: S3 or CLOUDINARY. The other becomes the automatic fallback.
STORAGE_PRIMARY=S3

# Set to false to disable the automatic provider fallback (e.g. while debugging
# the primary). When disabled, failures surface as errors instead of rerouting.
STORAGE_FALLBACK_ENABLED=true

# TTL (seconds) for presigned GET (read) URLs.
SIGNED_URL_TTL_SECONDS=3600
# Phase 2: CloudFront distribution in front of the bucket. When set, read URLs
# are returned directly as <domain>/<key> and presigning is skipped.
CLOUDFRONT_DOMAIN=

# ---- Transactional email (Resend) ----
# API key from resend.com. When unset, email sending is skipped (logged only).
RESEND_API_KEY=
# Verified sender. Domain must be verified in Resend (SPF + DKIM records).
MAIL_FROM="Forge <invites@mail.forrge.tech>"
# Set to false in local dev to log emails instead of sending them.
EMAIL_ENABLED=true
