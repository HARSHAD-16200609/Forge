PORT=3000

NODE_ENV=development

# Local / development database (e.g. the external postgres container on localhost:5432).
DATABASE_URL="postgresql://admin:password@localhost:5432/Forge"

# Production database (AWS RDS). Only read when NODE_ENV=production.
# If unset in production, the app falls back to DATABASE_URL and logs a deprecation warning.
DATABASE_URL_PROD="postgresql://user:password@your-rds-host:5432/Forge"

# CA bundle for the production TLS connection. Defaults to /app/certs/global-bundle.pem.
# Only read when NODE_ENV=production.
DB_SSL_CA_PATH=/app/certs/global-bundle.pem

LOG_LEVEL=info

JWT_SECRET=replace_me_at_least_32_chars_long_placeholder
JWT_EXPIRES_IN=60m

REFRESH_TOKEN_SECRET=replace_me_at_least_32_chars_long_placeholder_xx
REFRESH_TOKEN_EXPIRES_IN=7d

COOKIE_SECRET=replace_me_at_least_32_chars_long_placeholder_xxx

CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=000000000000000
CLOUDINARY_API_SECRET=your_cloudinary_api_secret

GOOGLE_CLIENT_ID=your_google_client_id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your_google_client_secret
GOOGLE_REDIRECT_URI=http://localhost:3000/api/v1/auth/google/callback

GITHUB_CLIENT_ID=your_github_client_id
GITHUB_CLIENT_SECRET=your_github_client_secret
GITHUB_REDIRECT_URI=http://localhost:3000/api/v1/auth/github/callback

CLIENT_URL=http://localhost:5173

REDIS_URL=redis://localhost:6379
REALTIME_RELAY_ENABLED=false

VITE_API_BASE_URL=http://localhost:3000/api/v1
