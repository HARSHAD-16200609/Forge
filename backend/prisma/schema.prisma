generator client {
  provider        = "prisma-client"
  output          = "../generated/prisma"
  previewFeatures = ["partialIndexes"]
}

datasource db {
  provider = "postgresql"
}

model user {
  id                       String               @id @default(uuid())
  name                     String
  email                    String               @unique
  avatar                   String?
  timezone                 String?
  password                 String?
  username                 String               @unique
  avatarPublicId           String?
  avatarSeed               String?
  oauthAccounts            OAuthAccount[]
  sessions                 Session[]
  channelInvitesSent       channelInvite[]      @relation("channelInvitesSent")
  channelInvitesReceived   channelInvite[]      @relation("channelInvitesReceived")
  convoMemberships         conversationMember[]
  messages                 message[]
  notificationsTriggered   notification[]       @relation("NotificationActor")
  notificationsReceived    notification[]       @relation("NotificationRecipient")
  reactions                reaction[]
  workspaceInvitesSent     workspaceInvite[]    @relation("workspaceInvitesSent")
  workspaceInvitesReceived workspaceInvite[]    @relation("workspaceInvitesReceived")
  memberships              workspaceMember[]
}

model Session {
  id               String   @id @default(cuid())
  userId           String
  expiresAt        DateTime
  createdAt        DateTime @default(now())
  ipAddress        String?
  refreshTokenHash String   @unique
  userAgent        String?
  browser          String?
  deviceName       String?
  os               String?
  user             user     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model workspace {
  id            String            @id @default(uuid())
  visibility    Visibility        @default(PUBLIC)
  description   String?
  createdAt     DateTime          @default(now())
  updatedAt     DateTime          @updatedAt
  workspaceName String
  channels      channel[]
  conversations conversation[]
  invites       workspaceInvite[]
  members       workspaceMember[]
}

model workspaceMember {
  id                 String          @id @default(uuid())
  role               Role            @default(MEMBER)
  joinedAt           DateTime        @default(now())
  userId             String
  workspaceId        String
  channels           channel[]
  channelMemberships channelMember[]
  user               user            @relation(fields: [userId], references: [id], onDelete: Cascade)
  workspace          workspace       @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@unique([userId, workspaceId])
}

model channel {
  id                         String          @id @default(uuid())
  visibility                 Visibility      @default(PUBLIC)
  channelName                String
  description                String?
  workspaceId                String
  createdAt                  DateTime        @default(now())
  updatedAt                  DateTime        @updatedAt
  createdByWorkspaceMemberId String
  isDefault                  Boolean         @default(false)
  createdBy                  workspaceMember @relation(fields: [createdByWorkspaceMemberId], references: [id])
  workspace                  workspace       @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  invites                    channelInvite[]
  members                    channelMember[]
  messages                   message[]
  uploads                    upload[]

  @@unique([workspaceId, channelName])
}

model channelMember {
  id                String          @id @default(uuid())
  workspaceMemberId String
  channelId         String
  isCreator         Boolean         @default(false)
  joinedAt          DateTime        @default(now())
  channel           channel         @relation(fields: [channelId], references: [id], onDelete: Cascade)
  workspaceMember   workspaceMember @relation(fields: [workspaceMemberId], references: [id], onDelete: Cascade)

  @@unique([workspaceMemberId, channelId])
}

model message {
  id             String        @id @default(uuid())
  content        String
  senderId       String
  sentAt         DateTime      @default(now())
  editedAt       DateTime?
  channelId      String?
  conversationId String?
  parentMsgId    String?
  deletedAt      DateTime?
  channel        channel?      @relation(fields: [channelId], references: [id], onDelete: Cascade)
  conversation   conversation? @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  parentMsg      message?      @relation("MessageReplies", fields: [parentMsgId], references: [id])
  replies        message[]     @relation("MessageReplies")
  sender         user          @relation(fields: [senderId], references: [id], onDelete: NoAction)
  reactions      reaction[]
  uploads        upload[]

  @@index([channelId, sentAt])
  @@index([conversationId, sentAt])
  @@index([parentMsgId])
}

model conversation {
  id             String               @id @default(uuid())
  type           ConvoType            @default(DM)
  createdAt      DateTime             @default(now())
  groupName      String?
  updatedAt      DateTime             @updatedAt
  idempotencyKey String               @unique
  workspaceId    String
  workspace      workspace            @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  members        conversationMember[]
  messages       message[]
  uploads        upload[]

  @@unique([workspaceId, idempotencyKey])
}

model conversationMember {
  id           String       @id @default(uuid())
  userId       String
  convoId      String
  joinedAt     DateTime     @default(now())
  conversation conversation @relation(fields: [convoId], references: [id], onDelete: Cascade)
  user         user         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, convoId])
  @@index([userId])
  @@index([convoId])
}

model reaction {
  id        String  @id @default(uuid())
  emoji     String
  messageId String
  userId    String
  message   message @relation(fields: [messageId], references: [id], onDelete: Cascade)
  reactedBy user    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, messageId, emoji])
}

model notification {
  id          String            @id @default(uuid())
  type        NotificationType?
  entity      EntityType?
  entityId    String?
  read        Boolean           @default(false)
  createdAt   DateTime          @default(now())
  receipentId String
  actorId     String?
  metadata    Json?
  actor       user?             @relation("NotificationActor", fields: [actorId], references: [id])
  receiver    user              @relation("NotificationRecipient", fields: [receipentId], references: [id], onDelete: Cascade)

  @@index([receipentId, read])
}

model upload {
  id             String        @id @default(uuid())
  fileType       fType
  filename       String
  messageId      String?
  uploadedAt     DateTime      @default(now())
  mimeType       String
  publicId       String        @unique
  url            String
  fileSize       Int
  deletedAt      DateTime?
  uploaderId     String
  channelId      String?
  conversationId String?
  channel        channel?      @relation(fields: [channelId], references: [id])
  conversation   conversation? @relation(fields: [conversationId], references: [id])
  message        message?      @relation(fields: [messageId], references: [id], onDelete: Cascade)

  @@index([channelId, uploadedAt])
  @@index([conversationId, uploadedAt])
}

model workspaceInvite {
  id            String    @id @default(uuid())
  status        Status    @default(PENDING)
  sentAt        DateTime  @default(now())
  actorId       String
  receiverId    String
  workspaceId   String
  expiresAt     DateTime
  receiverEmail String
  acceptedAt    DateTime?
  actor         user      @relation("workspaceInvitesSent", fields: [actorId], references: [id], onDelete: Cascade)
  receiver      user      @relation("workspaceInvitesReceived", fields: [receiverId], references: [id], onDelete: Cascade)
  workspace     workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@unique([receiverId, workspaceId], where: raw("(status = 'PENDING'::\"Status\")"))
}

model OAuthAccount {
  id         String       @id @default(uuid())
  provider   ProviderName
  providerId String
  userId     String
  user       user         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerId])
}

model channelInvite {
  id            String    @id @default(uuid())
  status        Status    @default(PENDING)
  sentAt        DateTime  @default(now())
  actorId       String
  receiverId    String
  channelId     String
  expiresAt     DateTime
  receiverEmail String
  acceptedAt    DateTime?
  actor         user      @relation("channelInvitesSent", fields: [actorId], references: [id], onDelete: Cascade)
  channel       channel   @relation(fields: [channelId], references: [id], onDelete: Cascade)
  receiver      user      @relation("channelInvitesReceived", fields: [receiverId], references: [id], onDelete: Cascade)

  @@unique([receiverId, channelId], where: raw("(status = 'PENDING'::\"Status\")"))
}

enum Visibility {
  PRIVATE
  PUBLIC
}

enum ConvoType {
  DM
  GDM
}

enum NotificationType {
  MENTION
  REPLY
  REACTION
  CHANNEL_INVITE
  WORKSPACE_INVITE
  DIRECT_MESSAGE
}

enum EntityType {
  MESSAGE
  CHANNEL
  WORKSPACE
  CONVO
}

enum fType {
  IMAGE
  VIDEO
  AUDIO
  DOCUMENT
  ARCHIVE
  OTHER
}

enum Status {
  ACCEPTED
  REJECTED
  PENDING
  EXPIRED
  REVOKED
}

enum ProviderName {
  Google
  Github
}

enum Role {
  OWNER
  ADMIN
  MEMBER
}
